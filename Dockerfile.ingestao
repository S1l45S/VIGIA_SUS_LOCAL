FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        gcc \
        g++ \
        libffi-dev \
        libgdal-dev \
        libproj-dev \
        libgeos-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-ingestao.txt ./

# O pysus 2.11.7 exige pandas 2.x, por isso a imagem de ingestão usa uma
# versão diferente da do requirements.txt, que é usada pelos testes e pelo CI.
RUN python -m pip install --no-cache-dir --upgrade pip \
    && grep -v '^pandas==' requirements.txt > /tmp/requirements-base.txt \
    && python -m pip install --no-cache-dir \
        -r /tmp/requirements-base.txt \
    && python -m pip install --no-cache-dir \
        "pandas==2.3.3" \
        -r requirements-ingestao.txt

COPY . .

CMD ["python", "manage.py", "--help"]
